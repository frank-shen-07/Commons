  "narrative": {
    "northStar": "The Welcoming Software Library",
    "overview": "Commons is a light-first software library: calm editorial hierarchy, compact utility controls, and approachable app imagery. The user-selected balance is 60% Mac App Store, 25% Raycast, and 15% Setapp; this is directional inspiration, not permission to copy their identities.\n\nWhite surfaces sit on a cool gray canvas. Ink headings establish hierarchy; blue directs action and pale blue marks selection. Real app imagery carries personality while the surrounding interface stays restrained. The same primitives can support the teammate-owned developer portal without importing the marketplace\u2019s page composition.",
    "keyCharacteristics": [
      "Light canvas and white surfaces",
      "Compact Inter typography with clear hierarchy",
      "Blue actions and pale blue selection",
      "Rounded panels, fine borders, restrained motion"
    ],
    "rules": [
      {
        "name": "The Action Blue Rule",
        "body": "Use blue to signal action, focus, or selection; keep ordinary reading text in ink or muted neutrals.",
        "section": "colors"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Separate ordinary surfaces with tone and fine borders. Reserve the existing shadow treatment for product imagery.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reuse the existing light palette and self-hosted Inter weights.",
      "Do preserve visible keyboard focus and reduced-motion behavior.",
      "Do let real application imagery carry visual variety.",
      "Do keep global design rules separate from route-specific composition in surface briefs."
    ],
    "donts": [
      "Don't add unsupported ratings, download counts, verification, or success claims.",
      "Don't replace the chosen light system with a dark-first interface.",
      "Don't turn compact metadata into competing headings.",
      "Don't invent portal form error or success styling and describe it as an existing component."
    ]
  }
