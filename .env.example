# Supabase project (required for authentication and database APIs).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
APP_URL=http://localhost:3000

# Required for server-managed profile/listing creation and review submission.
# Never expose this key in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional external public marketplace API base URL. Leave unset to use the
# local, explicitly labeled sample catalog.
MARKETPLACE_API_URL=http://localhost:3000/api

# Optional public distribution endpoint.
# The client substitutes {slug}, adds ?platform=windows|macos|linux|web,
# and expects { "platform": "windows", "url": "https://...", "label": "..." }.
# This URL is sent to the browser and must not contain credentials.
# DISTRIBUTION_DOWNLOAD_URL=https://your-api.example/downloads/{slug}
